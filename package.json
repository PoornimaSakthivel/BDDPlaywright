{
  "name": "playwright-bdd-framework",
  "version": "1.0.0",
  "private": true,
  "description": "BDD browser automation with Cucumber, TypeScript, and Playwright.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:bdd": "tsx test-runner/runner.ts",
    "test:bdd:html": "tsx test-runner/runner.ts",
    "test:bdd:headed": "cross-env HEADLESS=false tsx test-runner/runner.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^22.15.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "playwright": "^1.52.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
